{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codex Taskbar Quota",
  "mainBinaryName": "CodexTaskbarQuota",
  "version": "0.1.0",
  "identifier": "cn.fengshi.codex-quota-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Codex 任务栏额度设置", "width": 520, "height": 560, "resizable": true, "visible": true, "center": true, "transparent": true, "decorations": false, "shadow": false }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "worker-src": "blob:",
        "media-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:1420",
        "img-src": "'self' data:",
        "worker-src": "blob:",
        "media-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
